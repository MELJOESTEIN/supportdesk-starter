<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  CRM legacy — boîte noire de formation. Voir README.md.
	  Généré depuis start.spring.io (Boot 4.1.1, Java 25) : l'Initializr produit bien les noms
	  de starters Boot 4 (webmvc, webservices) et un starter de test par technologie.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>fr.acme.legacy</groupId>
	<artifactId>legacy-crm</artifactId>
	<version>1.0.0</version>
	<name>legacy-crm</name>
	<description>Referentiel clients legacy expose en SOAP</description>

	<properties>
		<java.version>25</java.version>
		<jaxb2-maven-plugin.version>4.1.0</jaxb2-maven-plugin.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webservices</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Le starter webservices n'embarque pas wsdl4j : il est requis pour publier un WSDL. -->
		<dependency>
			<groupId>wsdl4j</groupId>
			<artifactId>wsdl4j</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webservices-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  XSD -> classes JAXB. Sur Java 25, xjc n'est plus dans le JDK (JEP 320) :
			  la génération est une dépendance de build explicite.
			-->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>jaxb2-maven-plugin</artifactId>
				<version>${jaxb2-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>xjc</id>
						<goals><goal>xjc</goal></goals>
					</execution>
				</executions>
				<configuration>
					<sources><source>src/main/resources/schemas/clients.xsd</source></sources>
					<packageName>fr.acme.legacy.crm.contrat</packageName>
					<clearOutputDir>false</clearOutputDir>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>
