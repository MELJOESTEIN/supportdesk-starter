# Copier en .env — ce fichier ne doit jamais être commité.
#
# CES VALEURS NE SONT ACCEPTABLES QU'EN LOCAL.
#
# « supportdesk / supportdesk » et « admin / admin » sont écrits en clair dans un fichier
# d'exemple versionné : n'importe qui ayant accès au dépôt les connaît. En production,
# ces valeurs viennent d'un gestionnaire de secrets (Vault, AWS Secrets Manager, Docker
# secrets) et ne transitent jamais par un fichier du dépôt — pas même chiffré, pas même
# dans .gitignore : un fichier ignoré finit un jour par être ajouté à la main.
#
# Le test à se poser : si ce dépôt devenait public demain, que faudrait-il changer ?
# Réponse ici : tout ce qui suit.

POSTGRES_DB=supportdesk
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=supportdesk

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
