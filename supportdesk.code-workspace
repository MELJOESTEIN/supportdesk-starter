{
  "// AVERTISSEMENT": "Ouvre TOUJOURS ce workspace, ou le dossier racine — jamais backend/ ou frontend/ seuls. Claude Code lit CLAUDE.md et .claude/ depuis le dossier où il est lancé.",
  "folders": [
    {
      "name": "supportdesk (racine)",
      "path": "."
    },
    {
      "name": "backend",
      "path": "backend"
    },
    {
      "name": "frontend",
      "path": "frontend"
    }
  ],
  "settings": {
    "java.configuration.updateBuildConfiguration": "automatic",
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "editor.formatOnSave": true,
    "files.exclude": {
      "**/target": true,
      "**/.angular": true,
      "**/node_modules": true
    }
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code",
      "vscjava.vscode-java-pack",
      "vmware.vscode-boot-dev-pack",
      "angular.ng-template",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "vitest.explorer",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "humao.rest-client"
    ]
  }
}
